# Copy to .env and fill in. Never commit .env.

# Required off a personal laptop:
# VAULT_ROOT_TOKEN=

# Optional static machine token (read-only):
# VAULT_APP_TOKEN=

# Vite dev CORS (Docker UI is same-origin, no CORS needed):
VAULT_CORS_ORIGINS=http://localhost:5173

# Optional Telegram:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
